PORT=5050
MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/GRAYSKULL?retryWrites=true&w=majority

# Comma-separated list of allowed frontend origins (e.g. your Vercel URL).
# *.vercel.app preview deployments are auto-allowed regardless.
CLIENT_URL=https://your-app.vercel.app

NODE_ENV=development
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=30d

# Bootstrap super admin (only used by `npm run seed:auth`)
SUPER_ADMIN_EMAIL=ahilan@grayskull.com
SUPER_ADMIN_PASSWORD=Ahilan@123
SUPER_ADMIN_NAME=Ahilan
